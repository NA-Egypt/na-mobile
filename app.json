{
  "expo": {
    "name": "NA Egypt",
    "slug": "na-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": ["naegypt", "msauth.org.naegypt.app"],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#32557f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.naegypt.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#32557f"
      },
      "package": "org.naegypt.app"
    },
    "extra": {
      "eas": {
        "projectId": "na-egypt-mobile-app"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-document-picker",
        {
          "appleTeamId": "YOUR_TEAM_ID"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to photos to attach images to change requests.",
          "cameraPermission": "The app needs access to camera to take photos for change requests."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#32557f"
        }
      ]
    ]
  }
}
